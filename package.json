{
  "name": "sr4-sheet",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pug": "^3.0.4",
    "sass": "^1.108.1"
  },
  "scripts": {
    "generate:spirits": "node tools/generate-spirits.js",
    "sync:translations": "node tools/sync-translations.js",
    "compile:pug": "node tools/compile-pug.js",
    "compile:sass": "sass --no-source-map Shadowrun4thEdition.scss Shadowrun4thEdition.css",
    "cse": "node tools/to-cse.js",
    "build:legacy": "npm run generate:spirits && npm run sync:translations && npm run compile:pug && npm run compile:sass",
    "build": "npm run build:legacy && npm run cse",
    "test": "node tools/to-cse.test.js && node tools/worker-check.js",
    "update": "node tools/update.js"
  }
}
