.rolltemplates
  rolltemplate.sheet-rolltemplate-rolls
    .sheet-template-container
      //- Display a header on the template -
      .sheet-template-header
        | {{#header}}
        h1 {{header}}
        | {{/header}}
        | {{#base}}
        span {{base}}
        | {{/base}}
        | {{#rollLess() wound 0}}
        span  ♦ 
        span(data-i18n="wounds")
        | {{/rollLess() wound 0}}
        | {{#rollLess() mod 0}}
        span  ♦ 
        span(data-i18n="modifier")
        | {{/rollLess() mod 0}}
        | {{#rollGreater() mod 0}}
        span  ♦ 
        span(data-i18n="modifier")
        | {{/rollGreater() mod 0}}
        | {{#rollGreater() edge 0}}
        span  ♦ 
        span(data-i18n="edge")
        | {{/rollGreater() edge 0}}
      //- Display the dice roll in the template -
      .sheet-template-body
        //- Jet de sort complet (castSpell) : succes du sort, Force, Drain (valeur, resistance, restant)
        | {{#spellhits}}
        .sheet-template-row
          span.sheet-template-label(data-i18n="tpl_spellhits") Spell hits
          span.inlinerollresult {{spellhits}}
        .sheet-template-row.sheet-template-small
          span(data-i18n="force") Force
          |  {{spellforce}}
          | {{#spelldesc}}
          span  ♦ {{spelldesc}}
          | {{/spelldesc}}
        .sheet-template-row.sheet-template-small
          span(data-i18n="tpl_drainvalue") Drain value
          |  {{dv}}
          | {{#rollGreater() drainphys 0}}
          span(data-i18n="tpl_physical") (Physical: Force > Magic)
          | {{/rollGreater() drainphys 0}}
          | {{#^rollGreater() drainphys 0}}
          span(data-i18n="tpl_stun") (Stun)
          | {{/^rollGreater() drainphys 0}}
        .sheet-template-row.sheet-template-small
          span(data-i18n="tpl_drainres") Drain resistance hits
          |  {{drainres}}
        .sheet-template-row
          span.sheet-template-label(data-i18n="tpl_draintaken") Drain taken
          span.inlinerollresult {{computed::drainnet}}
          | {{#rollTotal() computed::drainnet 0}}
          span.sheet-template-desc(data-i18n="tpl_nodamage") no damage
          | {{/rollTotal() computed::drainnet 0}}
          | {{#rollGreater() computed::drainnet 0}}
          | {{#rollGreater() drainphys 0}}
          span.sheet-template-desc(data-i18n="tpl_boxesphysical") Physical box(es)
          | {{/rollGreater() drainphys 0}}
          | {{#^rollGreater() drainphys 0}}
          span.sheet-template-desc(data-i18n="tpl_boxesstun") Stun box(es)
          | {{/^rollGreater() drainphys 0}}
          | {{/rollGreater() computed::drainnet 0}}
        | {{/spellhits}}
        | {{#dice}}
        .sheet-template-row
          span.inlinerollresult {{dice}}
        | {{/dice}}
        //- Display a description. This is great for text included with a roll -
        | {{#desc}}
        .sheet-template-row
          span.sheet-template-desc 
            | {{desc}}
            | {{#rollGreater() rea 0}}
            span ,
            span(data-i18n="reach")
            | {{rea}}
            | {{/rollGreater() rea 0}}
            | {{#rollGreater() drain 1}}
            span ,
            span(data-i18n="drain")
            | {{drain}}
            | {{/rollGreater() drain 1}}
            | {{#rollLess() drain 1}}
            span ,
            span(data-i18n="drain-2")
            | {{drain}}
            | {{/rollLess() drain 1}}
        | {{/desc}}
